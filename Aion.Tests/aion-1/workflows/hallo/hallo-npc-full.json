{
  "Enabled": true,
  "Cron": "0/5 * * * * ?",
  "Logger": "@profile",
  "Steps": [
    {
      "Enabled": true,
      "FileName": "{{ Parameters.NpcExe }}",
      "Arguments": null,
      "Environment": {},
      "Timeout": null
    },
    {
      "Enabled": true,
      "FileName": "{{ Parameters.NpcExe }}",
      "Arguments": [
        "--named named",
        "positional",
        "--raw value",
        "--array-default one two three",
        "--array-separated one,two,three"
      ]
    },
    {
      "Enabled": false,
      "FileName": "{{ Parameters.NpcExe }}"
    },
    {
      "Enabled": true,
      "FileName": "{{ Parameters.NpcExe }}",
      "Arguments": [
        "--sleep 2"
      ],
      "Timeout": "00:00:01"
    }
  ]
}
