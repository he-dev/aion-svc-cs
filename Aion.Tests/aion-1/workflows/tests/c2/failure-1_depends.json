{
  "Enabled": true,
  "Sync": "0/15 * * * * ?",
  "Parameters": {
    "Exe": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Npc\\bin\\Debug\\net8.0\\Aion.Npc.exe",
    "msg": "This is step {{ step.index }} from {{ workflow.name }}."
  },
  "Steps": [
    {
      "Enabled": true,
      "FileName": "{{ Workflow.exe }}",
      "Arguments": "--sleep-seconds 0 --message \"{{ Workflow.msg }}\" --exit-code 1"
    },
    {
      "Enabled": true,
      "FileName": "{{ Workflow.exe }}",
      "Arguments": "--sleep-seconds 0 --message \"{{ Workflow.msg }}\" --exit-code 0",
      "DependsOn": "$previous"
    }
  ]
}
