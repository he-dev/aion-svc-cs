{
  "Enabled": true,
  "Sync": "0/15 * * * * ?",
  "Parameters": {
    "Exe": "{{ env \"DEV_HOME\" }}\\Aion\\Aion.Npc\\bin\\Debug\\net8.0\\Aion.Npc.exe",
    "msg": "This is step {{ step.index }} from {{ workflow.name }}."
  },
  "Steps": [
    {
      "Enabled": true,
      "FileName": "{{ Workflow.exe }}",
      "Arguments": "--sleep-seconds 5 --message \"{{ Workflow.msg }}\"",
      "Timeout": "0:00:03"
    }
  ]
}
