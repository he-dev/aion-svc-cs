

### Starts the downtime.
POST {{host}}{{profiles.hallo}}/downtimes:start
Content-Type: application/json

{
  "pattern": "hallo-npc-lite",
  "wait": "00:00:05",
  "duration": "00:01:00"
}

### Cannot start invalid downtime.
POST {{host}}{{profiles.hallo}}/downtimes:start
Content-Type: application/json

{
  "pattern": "hallo-npc-lite",
  "startsOn": "2026-01-26T10:20:00",
  "endsOn": "2026-01-26T10:10:00"
}

### Ends the downtime.
POST {{host}}{{profiles.hallo}}/downtimes:end
Content-Type: application/json

{
  "pattern": "hallo-npc-lite"
}

### Ends all downtimes.
POST {{host}}{{profiles.hallo}}/downtimes:end
Content-Type: application/json

{
  "pattern": null
}


